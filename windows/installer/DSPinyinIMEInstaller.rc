// DSPinyinIMEInstaller.rc — dialog, icon, embedded manifest, and payloads.
#include <windows.h>
#include "resource.h"

// Elevation + visual-styles manifest (CREATEPROCESS_MANIFEST_RESOURCE_ID=1,
// RT_MANIFEST=24).
1 24 "installer.manifest"

IDI_INSTALLER ICON "..\\dsime.ico"

// ---- Embedded payloads (built by build-installer.ps1 into ..\dist\<arch>\) ---
IDR_X64_TSF        RCDATA "..\\dist\\x64\\dsime_tsf.dll"
IDR_X64_CORE       RCDATA "..\\dist\\x64\\dsime.dll"
IDR_X64_SETTINGS   RCDATA "..\\dist\\x64\\DSPinyinIMESettings.exe"
IDR_ARM64_TSF      RCDATA "..\\dist\\arm64\\dsime_tsf.dll"
IDR_ARM64_CORE     RCDATA "..\\dist\\arm64\\dsime.dll"
IDR_ARM64_SETTINGS RCDATA "..\\dist\\arm64\\DSPinyinIMESettings.exe"

// The pinyin dictionary, once: architecture-independent (see resource.h). Not
// optional — without it the IME installs fine and then has no candidates.
IDR_DICT           RCDATA "..\\dist\\dsime.lex"

// ---- The installer window ---------------------------------------------------
IDD_INSTALLER DIALOGEX 0, 0, 380, 240
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Install DS Pinyin IME"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT   "DS Pinyin IME — LLM whole-sentence pinyin input method",
            IDC_TITLE, 16, 14, 348, 12
    LTEXT   "", IDC_BODY, 16, 34, 348, 104
    // Uninstall-only; hidden on a fresh install (a "delete my settings" box has
    // nothing to mean before there are any).
    CONTROL "Also delete my settings and API key", IDC_REMOVE_CONFIG, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 16, 142, 348, 10
    CONTROL "", IDC_PROGRESS, "msctls_progress32",
            PBS_MARQUEE | WS_BORDER | NOT WS_VISIBLE, 16, 158, 348, 10
    LTEXT   "", IDC_STATUS, 16, 174, 348, 22
    PUSHBUTTON    "Uninstall",        IDC_UNINSTALL, 16, 204, 80, 16
    PUSHBUTTON    "Close",            IDCANCEL,     102, 204, 52, 16
    DEFPUSHBUTTON "Install DS Pinyin IME", IDOK,    160, 204, 204, 16
END
